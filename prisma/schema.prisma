// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum VoucherStatus {
  PENDING
  ACTIVE
  EXPIRED
  USED
}

enum PaymentProvider {
  YAS
  AIRTEL
  VODACOM
  HALOTEL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  password     String
  role         Role             @default(ADMIN)
  isActive     Boolean          @default(true)
  avatarUrl    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  auditLogs    AuditLog[]
  chatMessages ChatMessage[]
  chatReads     ChatMessageRead[]
  chatParticipations ConversationParticipant[] @relation("ChatParticipant")
  sentMessages       Message[]                 @relation("ChatSender")
  messageReactions   MessageReaction[]         @relation("ChatReaction")
}

model Bundle {
  id            String    @id @default(cuid())
  name          String
  description   String?
  price         Float
  currency      String    @default("TZS")
  durationHours Int
  dataLimitMB   Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  vouchers      Voucher[]
}

model Voucher {
  id              String        @id @default(cuid())
  code            String        @unique
  bundleId        String
  bundle          Bundle        @relation(fields: [bundleId], references: [id])
  clientPhone     String
  clientName      String
  paymentProvider PaymentProvider
  paymentRef      String?
  amount          Float
  status          VoucherStatus @default(PENDING)
  expiresAt       DateTime?
  activatedAt     DateTime?
  createdAt       DateTime      @default(now())
  payments        Payment[]
  sessions        Session[]
  rating          ServiceRating?
}

model Payment {
  id          String        @id @default(cuid())
  voucherId   String
  voucher     Voucher       @relation(fields: [voucherId], references: [id])
  provider    PaymentProvider
  phoneNumber String
  amount      Float
  currency    String        @default("TZS")
  reference   String        @unique
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

model Session {
  id             String    @id @default(cuid())
  voucherId      String
  voucher        Voucher   @relation(fields: [voucherId], references: [id])
  clientMac      String
  clientIp       String
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?
  dataUsedMB     Float     @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime        @default(now())
  reads     ChatMessageRead[]
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  readAt    DateTime    @default(now())

  @@unique([messageId, userId])
}

model ServiceRating {
  id        String   @id @default(cuid())
  voucherId String   @unique
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Conversation {
  id             String                    @id @default(cuid())
  type           ConversationType          @default(DIRECT)
  name           String?
  description    String?
  avatarUrl      String?
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  participants   ConversationParticipant[]
  messages       Message[]
}

enum ConversationType {
  DIRECT
  GROUP
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ChatParticipant", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  @@unique([conversationId, userId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation("ChatSender", fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType       @default(TEXT)
  content        String
  fileName       String?
  fileSize       Int?
  deleted        Boolean           @default(false)
  createdAt      DateTime          @default(now())
  reactions      MessageReaction[]
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  EMOJI
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ChatReaction", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())
  @@unique([messageId, userId, emoji])
}
